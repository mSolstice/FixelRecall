{
  "name": "fixel-recall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "benchmark:synthetic:ci": "node scripts/generate-synthetic-benchmark-artifacts.mjs --seed 1 --output artifacts/fixel-recall-synthetic-benchmark",
    "beta:fake": "node scripts/fake-beta.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "canary:preflight": "node scripts/real-provider-canary-preflight.mjs",
    "check:skills": "node scripts/check-skill-sync.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "scan:test-canaries": "node scripts/scan-test-output-canaries.mjs",
    "smoke:anthropic": "node scripts/smoke/anthropic-fake-gateway.mjs",
    "smoke:official-hosts": "node scripts/smoke-official-hosts.mjs",
    "smoke:openai": "node scripts/smoke/openai-fake-gateway.mjs",
    "sync:skills": "node scripts/sync-skills.ts",
    "test": "vitest run",
    "test:compatibility": "vitest run tests/compatibility",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "stage:npm": "node scripts/stage-npm-package.mjs",
    "smoke:npm": "node scripts/smoke-npm-pack.mjs"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.13.0",
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "24.0.14",
    "esbuild": "^0.28.2",
    "eslint": "9.31.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.36.0",
    "vitest": "3.2.4"
  }
}
